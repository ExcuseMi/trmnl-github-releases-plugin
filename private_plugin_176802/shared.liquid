{% comment %} Get plugin settings {% endcomment %}
{% assign days_to_show = trmnl.plugin_settings.custom_fields_values.days_to_show | plus: 0 %}
{% assign include_prereleases = trmnl.plugin_settings.custom_fields_values.include_prereleasess | default: "no" %}
{% assign include_drafts = trmnl.plugin_settings.custom_fields_values.included_drafs | default: "no" %}
{% assign only_show_latest = trmnl.plugin_settings.custom_fields_values.only_show_latest | default: "no" %}
{% assign show_time_delta = trmnl.plugin_settings.custom_fields_values.show_time_delta | default: "Yes" %}
{% assign show_title_bar = trmnl.plugin_settings.custom_fields_values.show_title_bar | default: "Yes" %}

{% comment %} Configuration {% endcomment %}
{% assign items_per_column = 6 %}
{% assign number_of_columns = 2 %}

{% comment %} Set user locale {% endcomment %}
{% if trmnl.user.id == 6458 %}
  {% assign user_locale = "en" %}
{% else %}
  {% assign user_locale = trmnl.user.locale | default: "en" %}
{% endif %}

{% if user_locale contains "_" %}
  {% assign user_locale = user_locale | split: "_" | first %}
{% endif %}

{% comment %} Load translations {% endcomment %}
{% assign translations = all_translations[user_locale] %}
{% unless translations %}
  {% assign translations = all_translations["en"] %}
{% endunless %}

{% comment %} Assign translation variables {% endcomment %}
{% assign t_github_releases = translations.github_releases %}
{% assign t_last = translations.last %}
{% assign t_days = translations.days %}
{% assign t_day = translations.day %}
{% assign t_all_releases = translations.all_releases %}
{% assign t_no_releases_found = translations.no_releases_found %}
{% assign t_no_releases_found_time = translations.no_releases_found_time %}
{% assign t_since_previous = translations.since_previous %}

{% comment %} Process releases - apply date and type filters {% endcomment %}
{% assign processed_releases = "" | split: "" %}
{% assign current_timestamp_seconds = trmnl.system.timestamp_utc %}
{% assign seconds_in_days = 86400 | times: days_to_show %}
{% assign cutoff_timestamp_seconds = current_timestamp_seconds | minus: seconds_in_days %}

{% for release in all_releases %}
  {% assign should_include = true %}
  
  {% comment %} Check date filter {% endcomment %}
  {% if days_to_show > 0 %}
    {% assign release_timestamp = release.published_at | date: "%s" | times: 1 %}
    {% if release_timestamp < cutoff_timestamp_seconds %}
      {% assign should_include = false %}
    {% endif %}
  {% endif %}
  
  {% comment %} Check draft filter {% endcomment %}
  {% if include_drafts == "no" and release.draft == true %}
    {% assign should_include = false %}
  {% endif %}
  
  {% comment %} Check prerelease filter {% endcomment %}
  {% if include_prereleases == "no" and release.prerelease == true %}
    {% assign should_include = false %}
  {% endif %}
  
  {% comment %} Add to processed array if it passes all filters {% endcomment %}
  {% if should_include == true %}
    {% assign temp_array = all_releases | slice: forloop.index0, 1 %}
    {% assign processed_releases = processed_releases | concat: temp_array %}
  {% endif %}
{% endfor %}

{% comment %} Apply only_show_latest filter {% endcomment %}
{% if only_show_latest != "no" %}
  {% assign repo_groups = "" | split: "" %}
  {% assign latest_releases = "" | split: "" %}
  
  {% for release in processed_releases %}
    {% assign repo_found = false %}
    {% for group in repo_groups %}
      {% if group == release.repo_full_name %}
        {% assign repo_found = true %}
        {% break %}
      {% endif %}
    {% endfor %}
    
    {% unless repo_found %}
      {% assign temp_array = processed_releases | slice: forloop.index0, 1 %}
      {% assign latest_releases = latest_releases | concat: temp_array %}
      {% assign temp_group = release.repo_full_name | split: "|" %}
      {% assign repo_groups = repo_groups | concat: temp_group %}
    {% endunless %}
  {% endfor %}
  
  {% assign top_releases = latest_releases %}
{% else %}
  {% assign top_releases = processed_releases %}
{% endif %}

{% comment %} Sort releases by published date (newest first) {% endcomment %}
{% assign sorted_releases = top_releases | sort: "published_at" | reverse %}
{% assign top_releases = sorted_releases %}

{% comment %} Check if we have any releases to display {% endcomment %}
{% if top_releases.size > 0 %}
  {% assign start_index = 0 %}
{% else %}
  {% comment %} No releases to display {% endcomment %}
  <div class="no-releases">
    {% if days_to_show > 0 %}
      {{ t_no_releases_found_time | replace: '[days]', days_to_show }}
    {% else %}
      {{ t_no_releases_found }}
    {% endif %}
  </div>
{% endif %}

{% template release_template %}
<div class="item item--emphasis-{{ current_index | modulo: 3 | plus: 1 }}">
  <div class="meta"></div>
  <div class="content">
    <div class="title title--small lg:title--base">{{ release.repo_full_name }}</div>
    <div class="label label--inverted lg:label--large" data-clamp="2">{{ release.name }}</div>
    <div class="description lg:description--large">
      {% if release.prerelease %}Pre-release {% endif %}
      {% if release.draft %}Draft {% endif %}
      {{ release.published_at | l_date: '%-d %b %Y' }}
      {% if show_time_delta != "no" and release.seconds_since_previous %}
        <span class="time-delta" data-seconds="{{ release.seconds_since_previous }}"></span>
      {% endif %}
    </div>
  </div>
</div>
{% endtemplate %}

{% template columns %}
<div class="layout layout--stretch">
  <div class="columns" data-overflow-cols="{{ columns }}" 
    data-overflow-max-cols="{{ max_columns }}"
    data-overflow-max-cols-portrait="{{max_columns_portrait}}"
    data-overflow-max-cols-lg-portrait="{{max_columns_lg_portrait}}"

    >
    <div class="column">
      {% for release in top_releases %}
        {% assign current_index = forloop.index | plus: start_index %}
        {% render "release_template", release: release, current_index: current_index %}
      {% endfor %}
    </div>
  </div>
</div>
{% endtemplate %}


<script>
  (function() {
    function formatTimeDelta() {
      document.querySelectorAll('.time-delta').forEach(el => {
        const seconds = parseInt(el.dataset.seconds);
        if (!seconds) return;

        const minutes = Math.floor(seconds / 60);
        const hours = Math.floor(seconds / 3600);
        const days = Math.floor(seconds / 86400);
        const months = Math.floor(days / 30);
        const years = Math.floor(days / 365);

        let formatted;
        let unit;

        if (years > 0) {
          formatted = years;
          unit = years === 1 ? 'year' : 'years';
        } else if (months > 0) {
          formatted = months;
          unit = months === 1 ? 'month' : 'months';
        } else if (days > 0) {
          formatted = days;
          unit = days === 1 ? 'day' : 'days';
        } else if (hours > 0) {
          formatted = hours;
          unit = hours === 1 ? 'hour' : 'hours';
        } else if (minutes > 0) {
          formatted = minutes;
          unit = minutes === 1 ? 'minute' : 'minutes';
        } else {
          formatted = '<1';
          unit = 'minute';
        }

        el.textContent = '(+' + formatted + ' ' + unit + ')';
      });
    }

    // Run immediately
    formatTimeDelta();

    // Also run when DOM is ready (in case script runs before elements exist)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', formatTimeDelta);
    }
  })();
</script>